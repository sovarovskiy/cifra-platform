# Первый администратор (единственный, кто управляет списком почт)
ADMIN_EMAIL=sovarovsky@gmail.com

# Доп. почты менеджеров через запятую (важно для Vercel — постоянный список)
# ALLOWED_EMAILS=manager1@company.ru,manager2@company.ru

# Секрет для подписи сессий (сгенерируйте длинную случайную строку)
SESSION_SECRET=change-me-to-random-64-chars

# Google Sheets «Референс» — JSON сервисного аккаунта одной строкой (только на сервере / в .env.local)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}

# Порт dev-сервера
PORT=3002
